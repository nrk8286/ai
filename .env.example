# Copy this file to .env.local. Never commit the populated file.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# PostgreSQL (the Vercel Neon integration already provides DATABASE_URL).
# POSTGRES_URL is also accepted when DATABASE_URL is absent.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aimarket
# Optional direct connection for migrations. Neon provides this automatically.
DATABASE_URL_UNPOOLED=

# Local/self-hosted origin. Vercel infers its trusted deployment host.
AUTH_URL=http://localhost:3000
XAI_API_KEY=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
